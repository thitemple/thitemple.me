{
	"name": "thitemple.me",
	"version": "2.0.0",
	"private": true,
	"packageManager": "bun@1.3.6",
	"scripts": {
		"dev": "vite dev",
		"build": "export NODE_OPTIONS='--max-old-space-size=4096' && bun run sync:latest && vite build",
		"preview": "vite preview",
		"sync:latest": "node scripts/sync-latest.mjs",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"validate": "bun run lint && bun run check && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.5.1",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.0.0 <23.0.0"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1"
	},
	"trustedDependencies": [
		"esbuild"
	]
}
