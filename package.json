{
	"name": "thitemple.me",
	"version": "2.0.0",
	"private": true,
	"packageManager": "bun@1.3.6",
	"scripts": {
		"dev": "vite dev",
		"dev:search": "bun run build && vite dev",
		"build": "export NODE_OPTIONS='--max-old-space-size=4096' && vite build && bun run search:index",
		"preview": "vite preview",
		"search:index": "bun scripts/build-pagefind-index.mjs",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"validate:posts": "bun scripts/validate-posts.js",
		"validate": "bun run lint && bun run check && bun run validate:posts && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.4",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"glob": "^11.1.0",
		"globals": "^16.5.0",
		"gray-matter": "^4.0.3",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	},
	"type": "module",
	"engines": {
		"node": ">=22.0.0 <23.0.0"
	},
	"dependencies": {
		"@vercel/analytics": "^1.6.1",
		"clsx": "^2.1.1",
		"loops": "^6.3.0",
		"lucide-svelte": "^0.536.0",
		"mdsvex-relative-images": "^2.0.0",
		"medium-zoom": "^1.1.0",
		"rehype-slug": "^6.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-toc": "^9.0.0",
		"shiki": "^3.23.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"trustedDependencies": [
		"esbuild"
	]
}
